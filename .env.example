APP_NAME="NT Sistemas Web"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Local: SQLite. Produção (Coolify): PostgreSQL do docker-compose.coolify.yml.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=ntsistemas
# DB_USERNAME=ntsistemas
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# E-mail: sem SMTP, os avisos de novo contato vão só para o log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@ntsistemasweb.com.br"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Site (valores padrão; podem ser trocados em Admin › Ajustes do site)
SITE_CONTACT_EMAIL=contato@ntsistemasweb.com.br
SITE_NOTIFICATION_EMAIL=contato@ntsistemasweb.com.br
SITE_WHATSAPP=5551995492191
SITE_GITHUB_URL=https://github.com/tsilvas1712
SITE_LINKEDIN_URL=

# Estatísticas de acesso (Admin › Acessos). IPs ficam guardados por N dias.
SITE_ANALYTICS=true
SITE_ANALYTICS_RETENTION_DAYS=180
